{
  "name": "mhgu-launcher",
  "productName": "MHLAUNCHER",
  "version": "3.6.0",
  "description": "MHLAUNCHER: a central dos ports de Monster Hunter no PC (Generations Ultimate, 4 Ultimate, Freedom Unite), em português. Feito por licas.mp3.",
  "author": {
    "name": "licas.mp3",
    "email": "licasmp4@users.noreply.github.com"
  },
  "homepage": "https://github.com/licasmp4/MONSTER-HUNTER-GU-PORT-LAUNHCER",
  "license": "MIT",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prints": "electron . --prints",
    "windows": "electron-builder --win --x64 --publish never",
    "linux": "electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "adm-zip": "0.5.16"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.licas.mhgulauncher",
    "productName": "MHLAUNCHER",
    "copyright": "feito por licas.mp3",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json",
      "node_modules/**",
      "!**/*.map"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MHLAUNCHER-${version}-windows.exe"
    },
    "portable": {
      "artifactName": "MHLAUNCHER-${version}-windows.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "MHLAUNCHER-${version}-linux.${ext}",
      "maintainer": "licas.mp3 <licasmp4@users.noreply.github.com>"
    }
  }
}
