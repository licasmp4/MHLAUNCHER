<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MHGU Launcher" Width="1160" Height="760" MinWidth="820" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False" Background="#141416"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#141416"/>
    <LinearGradientBrush x:Key="Side" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1CFFFFFF" Offset="0"/><GradientStop Color="#0DFFFFFF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#21FFFFFF" Offset="0"/><GradientStop Color="#0FFFFFFF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="Rim" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#59FFFFFF" Offset="0"/><GradientStop Color="#14FFFFFF" Offset="0.35"/><GradientStop Color="#0AFFFFFF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBtn" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#38FFFFFF" Offset="0"/><GradientStop Color="#1FFFFFFF" Offset="1"/></LinearGradientBrush>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="CardHi" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="Sub" Color="#A1A1A6"/>
    <SolidColorBrush x:Key="Gold" Color="#D1D1D6"/>
    <SolidColorBrush x:Key="GoldHi" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ok" Color="#30D158"/>
    <SolidColorBrush x:Key="Bad" Color="#FF453A"/>

    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style x:Key="H1" TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="FontFamily" Value="{DynamicResource Display}"/><Setter Property="FontSize" Value="34"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="2,0,0,2"/></Style>
    <Style x:Key="H1Sub" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="Margin" Value="2,0,0,22"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="Margin" Value="0,4,0,6"/></Style>
    <Style x:Key="Lbl" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/></Style>
    <Style x:Key="Val" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource GoldHi}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="MinWidth" Value="56"/><Setter Property="TextAlignment" Value="Right"/></Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/><Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,0,18"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rim}"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Row" TargetType="Grid"><Setter Property="Margin" Value="0,9,0,9"/></Style>

    <!-- item do menu lateral: pílula como no Apple Music -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="GroupName" Value="nav"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="g" Margin="10,1" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="sc"/></Grid.RenderTransform>
            <Border x:Name="hov" Background="#14FFFFFF" Opacity="0" CornerRadius="7"/>
            <Border x:Name="b" Background="{StaticResource GlassBtn}" BorderBrush="{StaticResource Rim}" BorderThickness="1" Opacity="0" CornerRadius="9"/>
            <Grid Margin="10,7">
              <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#C7C7CC" VerticalAlignment="Center"/>
              <ContentPresenter x:Name="txt" Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <!-- caixa de texto sem moldura (busca) -->
    <Style x:Key="Plain" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource GoldHi}"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="28,0,8,0" VerticalAlignment="Center"/></ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <!-- interruptor -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="44" Height="26">
            <Border CornerRadius="13" Background="#48484A"/>
            <Border x:Name="on" CornerRadius="13" Background="#F5F5F7" Opacity="0"/>
            <Ellipse x:Name="k" Width="22" Height="22" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0">
              <Ellipse.RenderTransform><TranslateTransform x:Name="kx"/></Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="k" Property="Fill" Value="#1C1C1E"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="kx" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="kx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <!-- slider -->
    <Style x:Key="ThumbS" TargetType="Thumb">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Thumb"><Ellipse Width="18" Height="18" Fill="{StaticResource GoldHi}" Stroke="#141416" StrokeThickness="3"/></ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="RepS" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"><Border Height="5" CornerRadius="3" Background="{TemplateBinding Background}"/></Border></ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Track x:Name="PART_Track" Height="22">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource RepS}" Background="{StaticResource Gold}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource RepS}" Background="#48484A" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource ThumbS}"/></Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <!-- botões -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource GlassBtn}"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="g" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="sc"/></Grid.RenderTransform>
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="{StaticResource Rim}" BorderThickness="1"/>
            <Border x:Name="hi" Background="#FFFFFF" Opacity="0" CornerRadius="9"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hi" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hi" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06"/>
                <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="g" Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinWidth" Value="52"/>
    </Style>
    <Style x:Key="Play" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#1C1C1E"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="sc"/></Grid.RenderTransform>
            <Border x:Name="b" CornerRadius="10" Padding="0,14">
              <Border.Effect><DropShadowEffect x:Name="glow" Color="#FFFFFF" BlurRadius="16" ShadowDepth="0" Opacity="0"/></Border.Effect>
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#D1D1D6" Offset="1"/></LinearGradientBrush></Border.Background>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#1C1C1E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ContentPresenter TextElement.FontSize="15" TextElement.FontWeight="SemiBold" TextElement.Foreground="#1C1C1E" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="30" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.2"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.25"/>
                <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25"/>
                <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="sc"/></Grid.RenderTransform>
            <Ellipse x:Name="b" Fill="#FFFFFF" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.06"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.06"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent" CornerRadius="0,11,0,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E81123"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <Style x:Key="ShelfBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Opacity" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="sc"/></Grid.RenderTransform>
            <Ellipse Fill="#E62C2C2E" Stroke="#26FFFFFF"><Ellipse.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/></Ellipse.Effect></Ellipse>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.06"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.06"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <!-- cartão de modo (Hospedar/Entrar) -->
    <Style x:Key="ModeCard" TargetType="RadioButton">
      <Setter Property="GroupName" Value="mode"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="b" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Rim}" BorderThickness="1.5" CornerRadius="16" Padding="18,16" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="sc"/></Border.RenderTransform>
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CardHi}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/><Setter TargetName="b" Property="Background" Value="#1AFFFFFF"/></Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.06"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.06"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#33000000"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <!-- combobox escuro -->
    <Style x:Key="CbToggle" TargetType="ToggleButton">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="#33000000" BorderBrush="{StaticResource Rim}" BorderThickness="1" CornerRadius="9">
            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#A1A1A6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
          </Border>
          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="b" Padding="12,7" Background="Transparent" CornerRadius="5"><ContentPresenter/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#38383A"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource GoldHi}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Width" Value="220"/><Setter Property="Height" Value="36"/><Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource CbToggle}" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" Margin="12,0,30,0" VerticalAlignment="Center"/>
            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" BorderThickness="0" Margin="2,0,28,0" VerticalAlignment="Center"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="#F22C2C2E" BorderBrush="#38383A" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,4,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300">
                <ScrollViewer><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="SbThumb" TargetType="Thumb">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Thumb"><Border x:Name="b" CornerRadius="3" Background="#48484A"/>
          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#636366"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/><Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb><Thumb Style="{StaticResource SbThumb}"/></Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="root" Background="{StaticResource Bg}" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><ScaleTransform x:Name="rootScale"/></Border.RenderTransform>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="colSide" Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <!-- fundo: cena do jogo desfocada atrás de tudo (vídeos da cópia do próprio jogador) -->
      <Grid x:Name="bgLayer" Grid.ColumnSpan="2" IsHitTestVisible="False">
        <Image x:Name="bgA" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="Linear"/>
        <Image x:Name="bgB" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="Linear"/>
        <Rectangle Fill="#A30B0B0D"/>
      </Grid>

      <!-- menu lateral (estilo Apple Music) -->
      <Border x:Name="sidebar" Background="{StaticResource Side}" BorderBrush="#1FFFFFFF" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="18,20,16,6">
            <StackPanel x:Name="brand" Orientation="Horizontal">
              <Border Width="38" Height="38" CornerRadius="9" ClipToBounds="True">
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45"/></Border.Effect>
                <Border.Background><ImageBrush x:Name="imgLogo" Stretch="UniformToFill"/></Border.Background>
              </Border>
              <StackPanel x:Name="brandText" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Monster Hunter" FontFamily="{DynamicResource Display}" FontSize="15" FontWeight="Bold"/>
                <TextBlock x:Name="txtLauncherVer" Text="Generations Ultimate" FontSize="11.5" Foreground="{StaticResource Sub}"/>
              </StackPanel>
            </StackPanel>
            <!-- busca -->
            <Grid x:Name="searchBox" Margin="0,16,0,0">
              <Border Background="{StaticResource GlassBtn}" BorderBrush="{StaticResource Rim}" BorderThickness="1" CornerRadius="9" Height="32"/>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
              <TextBlock x:Name="searchHint" Text="Buscar ajuste" FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False"/>
              <TextBox x:Name="txtSearch" Style="{StaticResource Plain}"/>
              <Popup x:Name="searchPop" PlacementTarget="{Binding ElementName=searchBox}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                <Border Background="#F22C2C2E" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,6,0,0" Width="300" MaxHeight="340">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="searchList"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" Padding="16,10,16,18">
            <StackPanel>
              <Button x:Name="btnPlay" Style="{StaticResource Play}" Content="Jogar"/>
              <TextBlock x:Name="txtCredit" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource Sub}">feito por <Run Text="licas.mp3" Foreground="{StaticResource GoldHi}" FontWeight="SemiBold"/></TextBlock>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="navScroll" VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="0,6,0,0">
              <TextBlock x:Name="capPlay" Text="Jogar" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" Margin="26,10,0,4"/>
              <RadioButton x:Name="navHome" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Início" IsChecked="True"/>
              <RadioButton x:Name="navOnline" Style="{StaticResource Nav}" Tag="&#xE774;" Content="Online"/>
              <RadioButton x:Name="navHunt" Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="Caçada"/>
              <TextBlock x:Name="capSet" Text="Ajustes" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" Margin="26,14,0,4"/>
              <RadioButton x:Name="navVideo" Style="{StaticResource Nav}" Tag="&#xE7F4;" Content="Gráficos"/>
              <RadioButton x:Name="navPerf" Style="{StaticResource Nav}" Tag="&#xEC4A;" Content="FPS e Hz"/>
              <RadioButton x:Name="navCtrl" Style="{StaticResource Nav}" Tag="&#xE7FC;" Content="Controles"/>
              <TextBlock x:Name="capMore" Text="Mais" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" Margin="26,14,0,4"/>
              <RadioButton x:Name="navMods" Style="{StaticResource Nav}" Tag="&#xE74C;" Content="Mods e Cheats"/>
              <RadioButton x:Name="navAbout" Style="{StaticResource Nav}" Tag="&#xE946;" Content="Sobre"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- conteúdo -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition/></Grid.RowDefinitions>
        <Border x:Name="titleBar" Background="Transparent">
          <Grid>
            <!-- mini-player da cena (Apple Music) -->
            <Border x:Name="miniPlayer" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="430" Height="44" CornerRadius="12" Background="{StaticResource GlassBtn}" BorderBrush="{StaticResource Rim}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="6" Margin="6,0,10,0"><Border.Background><ImageBrush x:Name="miniThumb" Stretch="UniformToFill"/></Border.Background></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="miniTitle" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="Monster Hunter Generations Ultimate" FontSize="11" Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                  <Button x:Name="miniPrev" Style="{StaticResource IconBtn}" Content="&#xE892;" ToolTip="Cena anterior"/>
                  <Button x:Name="miniPlay" Style="{StaticResource IconBtn}" Content="&#xE769;" FontSize="14" ToolTip="Pausar / tocar"/>
                  <Button x:Name="miniNext" Style="{StaticResource IconBtn}" Content="&#xE893;" ToolTip="Próxima cena"/>
                </StackPanel>
                <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="2" Margin="10,0,10,1" CornerRadius="1" Background="#1FFFFFFF">
                  <Border x:Name="miniProg" HorizontalAlignment="Left" Width="0" CornerRadius="1" Background="#B3FFFFFF"/>
                </Border>
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
              <Button x:Name="btnMin" Style="{StaticResource WinBtn}" Content="&#xE921;"/>
              <Button x:Name="btnMax" Style="{StaticResource WinBtn}" Content="&#xE922;"/>
              <Button x:Name="btnClose" Style="{StaticResource WinBtnClose}" Content="&#xE8BB;"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="toastBox" Grid.Row="1" Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                Background="#F22C2C2E" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="18" Padding="16,8" Opacity="0" IsHitTestVisible="False">
          <Border.RenderTransform><TranslateTransform x:Name="toastY" Y="12"/></Border.RenderTransform>
          <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
          <TextBlock x:Name="txtToast" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
        </Border>
        <Grid x:Name="pages" Grid.Row="1" Margin="34,0,26,24">

          <!-- INÍCIO -->
          <ScrollViewer x:Name="pgHome" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <Border x:Name="hero" CornerRadius="20" Height="300" Margin="0,0,0,18" BorderBrush="{StaticResource Rim}" BorderThickness="1">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#12151C" Offset="0"/><GradientStop Color="#171C27" Offset="0.6"/><GradientStop Color="#2A2216" Offset="1"/></LinearGradientBrush>
                </Border.Background>
                <Grid x:Name="heroGrid">
                  <!-- cena do jogo (o mesmo vídeo do fundo, nítido) -->
                  <Grid x:Name="heroVideo" Opacity="0">
                    <Grid x:Name="vidHost" Background="Black">
                      <MediaElement x:Name="vid" LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True" Stretch="UniformToFill" ScrubbingEnabled="False" RenderOptions.BitmapScalingMode="Linear"/>
                      <Rectangle x:Name="vidFade" Fill="Black" Opacity="1"/>
                    </Grid>
                  </Grid>
                  <Rectangle RadiusX="17" RadiusY="17" IsHitTestVisible="False">
                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.35"/><GradientStop Color="#E60B0D12" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                  </Rectangle>
                  <Rectangle RadiusX="17" RadiusY="17" IsHitTestVisible="False">
                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#990B0D12" Offset="0"/><GradientStop Color="#000B0D12" Offset="0.6"/></LinearGradientBrush></Rectangle.Fill>
                  </Rectangle>
                  <Grid x:Name="heroArt">
                  <Ellipse Width="520" Height="420" HorizontalAlignment="Right" Margin="0,-120,-140,-120" IsHitTestVisible="False">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1FFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                  </Ellipse>
                  <Viewbox HorizontalAlignment="Right" Margin="0,18,56,18" IsHitTestVisible="False">
                    <Canvas Width="220" Height="230">
                      <Canvas.Resources><LinearGradientBrush x:Key="claw" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#8E8E93" Offset="1"/></LinearGradientBrush></Canvas.Resources>
                      <Path x:Name="claw1" Data="M10,25 C65,75 95,145 90,220" Stroke="{StaticResource claw}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9"/>
                      <Path x:Name="claw2" Data="M60,10 C115,65 150,140 145,217" Stroke="{StaticResource claw}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9"/>
                      <Path x:Name="claw3" Data="M110,0 C167,55 205,135 200,213" Stroke="{StaticResource claw}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9"/>
                    </Canvas>
                  </Viewbox>
                  </Grid>
                  <Border CornerRadius="12" Visibility="Collapsed"><Border.Background><ImageBrush x:Name="imgHero" Stretch="UniformToFill"/></Border.Background></Border>
                  <!-- etiqueta da cena (vidro) -->
                  <Border x:Name="scenePill" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,20,0,0" CornerRadius="14" Padding="12,5" Background="#59000000" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="7" Height="7" Fill="#FF4C5C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock x:Name="txtScene" FontSize="12" FontWeight="SemiBold" Foreground="#F2F4F8"/>
                    </StackPanel>
                  </Border>
                  <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,26">
                    <TextBlock Text="MHGU LAUNCHER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GoldHi}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtWelcome" Text="Bem-vindo, caçador!" TextOptions.TextFormattingMode="Ideal" FontFamily="{DynamicResource Display}" FontSize="40" FontWeight="ExtraBold"/>
                    <TextBlock Text="Tradução pt-BR por licas.mp3 · texturas HD · botões de PlayStation" FontSize="14" Foreground="#D9E0E6EE" Margin="0,4,0,0"/>
                    <TextBlock x:Name="txtHeroInfo" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GoldHi}" Margin="0,10,0,0"/>
                  </StackPanel>
                  <StackPanel x:Name="sceneDots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,30"/>
                </Grid>
              </Border>
              <Border x:Name="scenesCard" Visibility="Collapsed" Margin="0,0,0,16">
                <StackPanel>
                  <Grid Margin="2,0,2,10">
                    <TextBlock FontFamily="{DynamicResource Display}" FontSize="23" FontWeight="Bold">Cenas do jogo <Run Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#8E8E93"/></TextBlock>
                    <TextBlock Text="clique para ver em destaque" FontSize="12" Foreground="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                  </Grid>
                  <Grid x:Name="shelf">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" x:Name="scenesScroll">
                      <StackPanel x:Name="scenesList" Orientation="Horizontal"/>
                    </ScrollViewer>
                    <Button x:Name="shelfLeft" Style="{StaticResource ShelfBtn}" Content="&#xE76B;" HorizontalAlignment="Left" Margin="-14,0,0,24"/>
                    <Button x:Name="shelfRight" Style="{StaticResource ShelfBtn}" Content="&#xE76C;" HorizontalAlignment="Right" Margin="0,0,-14,24"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border x:Name="selfBox" Visibility="Collapsed" Background="#2230D158" BorderBrush="{StaticResource Ok}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                  <StackPanel Margin="0,0,190,0">
                    <TextBlock x:Name="txtSelfTitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ok}"/>
                    <TextBlock x:Name="txtSelfSub" Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <Button x:Name="btnSelfUpd" Style="{StaticResource Btn}" Content="Atualizar launcher" HorizontalAlignment="Right" VerticalAlignment="Center" Width="170" Background="{StaticResource Ok}" Foreground="#1C1C1E" FontWeight="SemiBold"/>
                </Grid>
              </Border>
              <Border x:Name="newsBox" Visibility="Collapsed" Style="{StaticResource Card}" BorderBrush="{StaticResource Ok}" BorderThickness="1">
                <StackPanel>
                  <Grid><TextBlock x:Name="txtNewsTitle" Style="{StaticResource CardTitle}" Foreground="{StaticResource Ok}"/><Button x:Name="btnNewsClose" Style="{StaticResource Btn}" Content="Entendi" HorizontalAlignment="Right" Padding="10,4" Margin="0,-6,0,0"/></Grid>
                  <TextBlock x:Name="txtNews" Style="{StaticResource Hint}" FontSize="13" LineHeight="21"/>
                </StackPanel>
              </Border>
              <Border x:Name="updBox" Visibility="Collapsed" Background="#1AFFFFFF" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                  <StackPanel Margin="0,0,190,0">
                    <TextBlock x:Name="txtUpdTitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource GoldHi}"/>
                    <TextBlock x:Name="txtUpdSub" Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <Button x:Name="btnUpdHome" Style="{StaticResource Btn}" Content="Atualizar agora" HorizontalAlignment="Right" VerticalAlignment="Center" Width="170" Background="{StaticResource Gold}" Foreground="#1C1C1E" FontWeight="SemiBold"/>
                </Grid>
              </Border>
              <UniformGrid x:Name="statsGrid" Columns="4" Margin="-6,0,-6,14">
                <Border Style="{StaticResource Card}" Margin="6,0"><StackPanel><TextBlock Text="Resolução" Style="{StaticResource CardTitle}"/><TextBlock x:Name="stRes" FontFamily="{DynamicResource Display}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="6,0"><StackPanel><TextBlock Text="Limite de FPS" Style="{StaticResource CardTitle}"/><TextBlock x:Name="stFps" FontFamily="{DynamicResource Display}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="6,0"><StackPanel><TextBlock Text="Mods ativos" Style="{StaticResource CardTitle}"/><TextBlock x:Name="stMods" FontFamily="{DynamicResource Display}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="6,0"><StackPanel><TextBlock Text="Online" Style="{StaticResource CardTitle}"/><TextBlock x:Name="stOnline" FontFamily="{DynamicResource Display}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
              </UniformGrid>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid><TextBlock Text="Seus caçadores" Style="{StaticResource CardTitle}"/><TextBlock x:Name="txtSaveSrc" FontSize="11" Foreground="{StaticResource Sub}" HorizontalAlignment="Right"/></Grid>
                  <UniformGrid x:Name="huntersPanel" Columns="3" Margin="-6,0"/>
                  <Border x:Name="importBox" Visibility="Collapsed" Background="#1AFFFFFF" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                    <Grid>
                      <StackPanel Margin="0,0,190,0"><TextBlock x:Name="txtImport" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="O save atual do PC vai para um backup antes." Style="{StaticResource Hint}"/></StackPanel>
                      <Button x:Name="btnImport" Style="{StaticResource Btn}" Content="Importar save" HorizontalAlignment="Right" VerticalAlignment="Center" Width="170" Background="{StaticResource Gold}" Foreground="#1C1C1E" FontWeight="SemiBold"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Dicas" Style="{StaticResource CardTitle}"/>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Text="• Som, música, brilho e idioma das legendas ficam no menu Opções dentro do jogo.&#x0a;• Insert abre o menu Forge (configura a barra de vida e os números de dano).&#x0a;• F12 tira screenshot (pasta shots) · F7 troca o anti-serrilhado · Alt+Enter alterna janela/tela cheia."/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- GRÁFICOS -->
          <ScrollViewer x:Name="pgVideo" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Gráficos" Style="{StaticResource H1}"/>
              <TextBlock Text="Tela, resolução e qualidade da imagem." Style="{StaticResource H1Sub}"/>
              <TextBlock Text="Perfil" Style="{StaticResource CardTitle}" Margin="2,0,0,8"/>
              <UniformGrid x:Name="perfilGrid" Columns="3" Margin="-6,0,-6,8">
                <RadioButton x:Name="pfLeve" Style="{StaticResource ModeCard}" GroupName="perfil" Margin="6,0">
                  <StackPanel>
                    <Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Rectangle Width="5" Height="6" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#F5F5F7"/><Rectangle Width="5" Height="11" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#48484A"/><Rectangle Width="5" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#48484A"/></StackPanel>
                      <Border x:Name="recLeve" Visibility="Collapsed" HorizontalAlignment="Right" CornerRadius="8" Padding="8,2" Background="#33FFFFFF">
                        <TextBlock Text="Recomendado" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                    </Grid>
                    <TextBlock Text="Leve" FontFamily="{DynamicResource Display}" FontSize="19" FontWeight="Bold" Margin="0,12,0,2"/>
                    <TextBlock x:Name="pfInfoLeve" FontSize="12" Foreground="{StaticResource Sub}" TextWrapping="Wrap"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="pfEquilibrado" Style="{StaticResource ModeCard}" GroupName="perfil" Margin="6,0">
                  <StackPanel>
                    <Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Rectangle Width="5" Height="6" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#F5F5F7"/><Rectangle Width="5" Height="11" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#F5F5F7"/><Rectangle Width="5" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#48484A"/></StackPanel>
                      <Border x:Name="recEquilibrado" Visibility="Collapsed" HorizontalAlignment="Right" CornerRadius="8" Padding="8,2" Background="#33FFFFFF">
                        <TextBlock Text="Recomendado" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                    </Grid>
                    <TextBlock Text="Equilibrado" FontFamily="{DynamicResource Display}" FontSize="19" FontWeight="Bold" Margin="0,12,0,2"/>
                    <TextBlock x:Name="pfInfoEquilibrado" FontSize="12" Foreground="{StaticResource Sub}" TextWrapping="Wrap"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="pfUltra" Style="{StaticResource ModeCard}" GroupName="perfil" Margin="6,0">
                  <StackPanel>
                    <Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><Rectangle Width="5" Height="6" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#F5F5F7"/><Rectangle Width="5" Height="11" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#F5F5F7"/><Rectangle Width="5" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#F5F5F7"/></StackPanel>
                      <Border x:Name="recUltra" Visibility="Collapsed" HorizontalAlignment="Right" CornerRadius="8" Padding="8,2" Background="#33FFFFFF">
                        <TextBlock Text="Recomendado" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                    </Grid>
                    <TextBlock Text="Ultra" FontFamily="{DynamicResource Display}" FontSize="19" FontWeight="Bold" Margin="0,12,0,2"/>
                    <TextBlock x:Name="pfInfoUltra" FontSize="12" Foreground="{StaticResource Sub}" TextWrapping="Wrap"/>
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
              <TextBlock x:Name="txtPerfil" Style="{StaticResource Hint}" Margin="2,0,0,20"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Tela" Style="{StaticResource CardTitle}"/>
                <Grid Style="{StaticResource Row}"><StackPanel><TextBlock Text="Modo de tela" Style="{StaticResource Lbl}"/><TextBlock Text="Sem borda = tela cheia rápida para trocar de janela." Style="{StaticResource Hint}"/></StackPanel><ComboBox x:Name="cbMode"/></Grid>
                <Grid Style="{StaticResource Row}"><StackPanel><TextBlock Text="Resolução da tela" Style="{StaticResource Lbl}"/><TextBlock Text="Tamanho da janela ou da tela cheia." Style="{StaticResource Hint}"/></StackPanel><ComboBox x:Name="cbRes"/></Grid>
                <Grid Style="{StaticResource Row}"><StackPanel><TextBlock Text="Proporção" Style="{StaticResource Lbl}"/><TextBlock Text="21:9 e 32:9 para monitores ultrawide." Style="{StaticResource Hint}"/></StackPanel><ComboBox x:Name="cbAspect"/></Grid>
                <Grid Style="{StaticResource Row}"><StackPanel><TextBlock Text="HUD em tela larga" Style="{StaticResource Lbl}"/><TextBlock Text="No centro (original) ou espalhado até as bordas." Style="{StaticResource Hint}"/></StackPanel><ComboBox x:Name="cbUi"/></Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Qualidade" Style="{StaticResource CardTitle}"/>
                <Grid Style="{StaticResource Row}"><StackPanel><TextBlock Text="Resolução 3D" Style="{StaticResource Lbl}"/><TextBlock Text="Acima da tela = mais nítido e mais pesado (4K reduzido fica lindo)." Style="{StaticResource Hint}"/></StackPanel><ComboBox x:Name="cbRender"/></Grid>
                <Grid Style="{StaticResource Row}"><StackPanel><TextBlock Text="Anti-serrilhado (MSAA)" Style="{StaticResource Lbl}"/><TextBlock Text="Suaviza bordas. Pesa em placas antigas." Style="{StaticResource Hint}"/></StackPanel><ComboBox x:Name="cbMsaa"/></Grid>
                <Grid Style="{StaticResource Row}"><StackPanel><TextBlock Text="FXAA" Style="{StaticResource Lbl}"/><TextBlock Text="Filtro leve de bordas do próprio jogo (deixa um pouco borrado)." Style="{StaticResource Hint}"/></StackPanel><CheckBox x:Name="tgFxaa" Style="{StaticResource Toggle}"/></Grid>
                <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Campo de visão (FOV)" Style="{StaticResource Lbl}"/><TextBlock Text="90° = padrão do jogo. Limite: 70° a 120°." Style="{StaticResource Hint}"/></StackPanel>
                  <Slider x:Name="slFov" Grid.Column="1" Minimum="70" Maximum="120" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,0"/>
                  <TextBlock x:Name="vFov" Grid.Column="2" Style="{StaticResource Val}"/></Grid>
                <WrapPanel x:Name="fovQuick" Margin="0,6,0,0"/>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>

          <!-- FPS -->
          <ScrollViewer x:Name="pgPerf" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="FPS e Hz" Style="{StaticResource H1}"/>
              <TextBlock x:Name="txtMonitor" Style="{StaticResource H1Sub}"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Limite de FPS" Style="{StaticResource CardTitle}"/>
                <Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                  <Slider x:Name="slFps" Minimum="30" Maximum="240" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"/>
                  <TextBlock x:Name="vFps" Grid.Column="1" FontFamily="{DynamicResource Display}" FontSize="34" FontWeight="ExtraBold" Foreground="{StaticResource GoldHi}" HorizontalAlignment="Right"/></Grid>
                <WrapPanel x:Name="fpsQuick"/>
                <TextBlock Text="30 = como no Switch. A velocidade do jogo é a mesma em qualquer FPS." Style="{StaticResource Hint}"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Sincronia" Style="{StaticResource CardTitle}"/>
                <Grid Style="{StaticResource Row}"><StackPanel><TextBlock Text="VSync" Style="{StaticResource Lbl}"/><TextBlock Text="Sem rasgos na imagem. O FPS não passa dos Hz do monitor." Style="{StaticResource Hint}"/></StackPanel><CheckBox x:Name="tgVsync" Style="{StaticResource Toggle}"/></Grid>
                <TextBlock x:Name="txtFpsTip" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>

          <!-- CONTROLES -->
          <ScrollViewer x:Name="pgCtrl" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Controles" Style="{StaticResource H1}"/>
              <TextBlock x:Name="txtPad" Style="{StaticResource H1Sub}"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <Grid><TextBlock Text="Conectados agora" Style="{StaticResource CardTitle}"/><TextBlock Text="atualiza sozinho" FontSize="11" Foreground="{StaticResource Sub}" HorizontalAlignment="Right"/></Grid>
                <StackPanel x:Name="padsList"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock x:Name="txtMapTitle" Text="Botões no seu controle" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="O jogo foi feito para o controle do Switch. Assim fica cada botão no seu controle:" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                <UniformGrid x:Name="padMap" Columns="2"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Tela cheia / janela" Style="{StaticResource CardTitle}"/>
                <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,70,0"><TextBlock Text="F11 = tela cheia  ·  Esc = modo janela" Style="{StaticResource Lbl}"/><TextBlock Text="Funciona com o jogo em foco. O launcher fica escondido enquanto o jogo roda e fecha junto com ele." Style="{StaticResource Hint}"/></StackPanel><CheckBox x:Name="tgHotkeys" Style="{StaticResource Toggle}"/></Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Atalhos do port (teclado)" Style="{StaticResource CardTitle}"/>
                <UniformGrid x:Name="keysMap" Columns="2"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Controle" Style="{StaticResource CardTitle}"/>
                <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,240,0"><TextBlock Text="Botões de ação" Style="{StaticResource Lbl}"/><TextBlock Text="Pela posição: confirmar no botão da direita (○), como no Switch. Combina com os ícones de PS." Style="{StaticResource Hint}"/></StackPanel><ComboBox x:Name="cbButtons"/></Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Mouse" Style="{StaticResource CardTitle}"/>
                <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Sensibilidade" Style="{StaticResource Lbl}"/><TextBlock Text="Clique no jogo para prender o mouse; Esc solta." Style="{StaticResource Hint}"/></StackPanel>
                  <Slider x:Name="slMouse" Grid.Column="1" Minimum="0.1" Maximum="5" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="10,0"/>
                  <TextBlock x:Name="vMouse" Grid.Column="2" Style="{StaticResource Val}"/></Grid>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ONLINE -->
          <ScrollViewer x:Name="pgOnline" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Online" Style="{StaticResource H1}"/>
              <TextBlock Text="Jogue com amigos pela rede local, por VPN (Radmin, ZeroTier, Hamachi) ou pela internet." Style="{StaticResource H1Sub}"/>
              <!-- amigos: presença entre launchers (porta do jogo + 1) -->
              <Border Style="{StaticResource Card}" Padding="18,12,18,14">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="Amigos" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0">
                      <Ellipse x:Name="meuPonto" Width="7" Height="7" Fill="{StaticResource Ok}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                      <TextBlock x:Name="txtMeuStatus" FontSize="12" Foreground="{StaticResource Sub}"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel x:Name="amigosList"/>
                  <TextBlock x:Name="txtSemAmigos" Style="{StaticResource Hint}" Margin="0,2,0,6" Text="Adicione o endereço do seu amigo (o IP do Radmin, como 26.12.34.56). Quando ele abrir o launcher, aparece aqui se está online, jogando ou com Hub aberto."/>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="txtNovoAmigo"/>
                    <TextBlock x:Name="hintNovoAmigo" Text="Endereço do amigo (ex.: 26.12.34.56)" FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <Button x:Name="btnAddAmigo" Grid.Column="1" Style="{StaticResource Btn}" Content="Adicionar" Margin="8,0,0,0" Width="110"/>
                  </Grid>
                </StackPanel>
              </Border>
              <UniformGrid x:Name="modeGrid" Columns="2" Margin="-6,0,-6,14">
                <RadioButton x:Name="rbHost" Style="{StaticResource ModeCard}" Margin="6,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel><TextBlock Text="Hospedar" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Eu crio o Hub e os amigos entram" FontSize="12" Foreground="{StaticResource Sub}"/></StackPanel>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="rbJoin" Style="{StaticResource ModeCard}" Margin="6,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel><TextBlock Text="Entrar" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Entro no Hub de um amigo" FontSize="12" Foreground="{StaticResource Sub}"/></StackPanel>
                  </StackPanel>
                </RadioButton>
              </UniformGrid>

              <!-- hospedar -->
              <StackPanel x:Name="panelHost">
                <Border Style="{StaticResource Card}"><StackPanel>
                  <TextBlock Text="Seu endereço (mande para os amigos)" Style="{StaticResource CardTitle}"/>
                  <StackPanel x:Name="ipList"/>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="btnPublicIp" Style="{StaticResource Btn}" Content="Descobrir IP da internet"/>
                  </StackPanel>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                  <TextBlock Text="Preparar o PC" Style="{StaticResource CardTitle}"/>
                  <Grid Style="{StaticResource Row}"><StackPanel><TextBlock Text="Firewall do Windows" Style="{StaticResource Lbl}"/><TextBlock x:Name="txtFw" Style="{StaticResource Hint}"/></StackPanel><Button x:Name="btnFirewall" Style="{StaticResource Btn}" Content="Liberar" HorizontalAlignment="Right" VerticalAlignment="Center" Width="120"/></Grid>
                  <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,140,0"><TextBlock Text="Porta" Style="{StaticResource Lbl}"/><TextBlock Text="Só pela internet sem VPN: abra esta porta (TCP e UDP) no roteador." Style="{StaticResource Hint}"/></StackPanel><TextBox x:Name="txtPort" Width="120" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Center"/></Grid>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                  <TextBlock Text="No jogo" Style="{StaticResource CardTitle}"/>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Text="1. Clique em Jogar e carregue seu save.&#x0a;2. Vá até o Hub (Salão dos Caçadores) e escolha Jogo Local (Local Play) &gt; Criar Hub.&#x0a;3. Seus amigos escolhem Entrar e colocam o seu endereço acima.&#x0a;Todos precisam do mesmo port e dos mesmos mods."/>
                </StackPanel></Border>
              </StackPanel>

              <!-- entrar -->
              <StackPanel x:Name="panelJoin" Visibility="Collapsed">
                <Border Style="{StaticResource Card}"><StackPanel>
                  <TextBlock Text="Endereço do amigo" Style="{StaticResource CardTitle}"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="txtJoin"/>
                    <Button x:Name="btnTest" Grid.Column="1" Style="{StaticResource Btn}" Content="Testar" Margin="8,0,0,0" Width="90"/>
                    <Button x:Name="btnSaveFriend" Grid.Column="2" Style="{StaticResource Btn}" Content="Salvar amigo" Margin="8,0,0,0"/></Grid>
                  <TextBlock Text="IP do Radmin/ZeroTier (ex.: 26.12.34.56) ou da internet. Porta diferente: 1.2.3.4:39500." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                  <TextBlock x:Name="txtTest" FontSize="13" Margin="0,8,0,0"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
                  <TextBlock Text="Amigos salvos" Style="{StaticResource CardTitle}"/>
                  <WrapPanel x:Name="friendsList"/>
                  <TextBlock x:Name="txtNoFriends" Text="Nenhum ainda. Digite o endereço e clique em Salvar amigo." Style="{StaticResource Hint}"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                  <TextBlock Text="No jogo" Style="{StaticResource CardTitle}"/>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Text="1. Peça para o amigo criar o Hub primeiro (Jogo Local &gt; Criar Hub).&#x0a;2. Clique em Jogar, vá até o Hub e escolha Jogo Local &gt; Procurar Hubs.&#x0a;O teste só dá certo com o Hub do amigo já aberto."/>
                </StackPanel></Border>
              </StackPanel>

              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Grupo sem dessincronia" Style="{StaticResource CardTitle}"/>
                <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,70,0"><TextBlock Text="Sincronizar monstros pequenos" Style="{StaticResource Lbl}"/><TextBlock Text="Jaggi, Aptonoth etc. no mesmo lugar e mortos para todos. Todo mundo do grupo deve usar igual." Style="{StaticResource Hint}"/></StackPanel><CheckBox x:Name="tgSync" Style="{StaticResource Toggle}"/></Grid>
                <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,140,0"><TextBlock Text="Versão do port" Style="{StaticResource Lbl}"/><TextBlock Text="Você e seus amigos precisam da MESMA versão. Compare este número com o deles." Style="{StaticResource Hint}"/></StackPanel><TextBlock x:Name="txtVerOnline" Style="{StaticResource Val}" FontSize="18"/></Grid>
                <Border Background="#161A22" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                  <TextBlock Style="{StaticResource Hint}" FontSize="12.5" LineHeight="20" Margin="0" Text="Monstros pequenos fora de sincronia (um morre pra você e continua vivo pro amigo) é do jogo original: no Switch cada jogador simula os seus. O port tenta sincronizar, mas só funciona com todos na mesma versão e com esta opção igual. O monstro só é sincronizado quando vocês estão na mesma área: quem chega primeiro manda neles."/>
                </Border>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>

          <!-- CAÇADA -->
          <ScrollViewer x:Name="pgHunt" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Caçada" Style="{StaticResource H1}"/>
              <TextBlock Text="Informações na tela e dificuldade dos monstros." Style="{StaticResource H1Sub}"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="HUD de caça" Style="{StaticResource CardTitle}"/>
                <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,70,0"><TextBlock Text="Barra de vida do monstro" Style="{StaticResource Lbl}"/><TextBlock x:Name="hintHp" Text="Vida atual, máxima e porcentagem do monstro marcado, com coroa e raiva." Style="{StaticResource Hint}"/></StackPanel><CheckBox x:Name="tgHpBar" Style="{StaticResource Toggle}"/></Grid>
                <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,70,0"><TextBlock Text="Números de dano" Style="{StaticResource Lbl}"/><TextBlock x:Name="hintDmg" Text="Mostra o dano de cada golpe seu (amarelo = ponto fraco)." Style="{StaticResource Hint}"/></StackPanel><CheckBox x:Name="tgDmg" Style="{StaticResource Toggle}"/></Grid>
                <TextBlock Text="A barra de vida aparece quando o monstro está marcado na câmera de alvo. No jogo, Insert abre o menu Forge &gt; Plugin UI (posição, cores, tamanho)." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <Grid><TextBlock Text="Diagnóstico da última caçada" Style="{StaticResource CardTitle}"/><Button x:Name="btnHudRefresh" Style="{StaticResource Btn}" Content="Atualizar" HorizontalAlignment="Right" Padding="10,4" Margin="0,-6,0,0"/></Grid>
                <StackPanel x:Name="hudDiag"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel x:Name="hpPanel">
                <TextBlock Text="Vida dos monstros (missões do Hub)" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="1.00 = original · 0.60 = 60% da vida · vale para todos no grupo (usa o do anfitrião)." Style="{StaticResource Hint}" Margin="0,0,0,6"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Missões da Vila e bônus" Style="{StaticResource CardTitle}"/>
                <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,70,0"><TextBlock Text="Missões da Vila no Hub" Style="{StaticResource Lbl}"/><TextBlock Text="No balcão do Hub, L/R troca para as missões da Vila (para jogar junto)." Style="{StaticResource Hint}"/></StackPanel><CheckBox x:Name="tgVillage" Style="{StaticResource Toggle}"/></Grid>
                <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Vida extra nelas" Style="{StaticResource Lbl}"/><TextBlock Text="Multiplica a vida das missões da Vila no Hub." Style="{StaticResource Hint}"/></StackPanel>
                  <Slider x:Name="slHubHp" Grid.Column="1" Minimum="0.5" Maximum="5" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="10,0"/>
                  <TextBlock x:Name="vHubHp" Grid.Column="2" Style="{StaticResource Val}"/></Grid>
                <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,70,0"><TextBlock Text="Conteúdo bônus" Style="{StaticResource Lbl}"/><TextBlock Text="Missões de evento, itens e Felynes grátis, copiados de um save doador (pasta bonus)." Style="{StaticResource Hint}"/></StackPanel><CheckBox x:Name="tgBonus" Style="{StaticResource Toggle}"/></Grid>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>

          <!-- MODS -->
          <ScrollViewer x:Name="pgMods" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Mods e Cheats" Style="{StaticResource H1}"/>
              <TextBlock Text="Ligue e desligue sem mexer em pastas. Vale ao abrir o jogo." Style="{StaticResource H1Sub}"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <Grid><TextBlock Text="Mods" Style="{StaticResource CardTitle}"/><Button x:Name="btnOpenMods" Style="{StaticResource Btn}" Content="Abrir pasta" HorizontalAlignment="Right" Padding="10,4" Margin="0,-6,0,0"/></Grid>
                <StackPanel x:Name="modsPanel"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <Grid><TextBlock Text="Cheats (.txt, versão 1.4.0)" Style="{StaticResource CardTitle}"/><Button x:Name="btnOpenCheats" Style="{StaticResource Btn}" Content="Abrir pasta" HorizontalAlignment="Right" Padding="10,4" Margin="0,-6,0,0"/></Grid>
                <StackPanel x:Name="cheatsPanel"/>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>

          <!-- SOBRE -->
          <ScrollViewer x:Name="pgAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Sobre" Style="{StaticResource H1}"/>
              <TextBlock Text="Quem fez cada parte." Style="{StaticResource H1Sub}"/>
              <Border CornerRadius="10" Padding="22,18" Margin="0,0,0,14" BorderBrush="{StaticResource Gold}" BorderThickness="1">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A2216" Offset="0"/><GradientStop Color="#F22C2C2E" Offset="1"/></LinearGradientBrush></Border.Background>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                  <StackPanel>
                    <TextBlock Text="MHGU Launcher + Tradução pt-BR" FontSize="13" Foreground="{StaticResource Sub}"/>
                    <TextBlock Text="licas.mp3" FontSize="30" FontWeight="Bold" Foreground="{StaticResource GoldHi}"/>
                    <TextBlock Text="Tradução completa, launcher, instalador e montagem do pacote para PC." FontSize="12" Foreground="{StaticResource Sub}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Créditos" Style="{StaticResource CardTitle}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="24" Text="Tradução pt-BR: licas.mp3&#x0a;Port de PC (MHGURecomp): morerokk — github.com/morerokk/MHGURecomp&#x0a;Texturas HD (MHGU HD Project): Monkbreh — github.com/Monkbreh/MHGU-HD-Project&#x0a;Barra de vida e números de dano: Lawrence-al (plugins Forge)&#x0a;Forge: Fexty12573&#x0a;Monster Hunter Generations Ultimate © CAPCOM. Use a sua própria cópia do jogo."/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Aparência" Style="{StaticResource CardTitle}"/>
                <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,70,0"><TextBlock Text="Cenas animadas" Style="{StaticResource Lbl}"/><TextBlock x:Name="hintVideo" Text="Cenas do jogo tocando no Início e no fundo do launcher (dos vídeos da sua cópia). Desligue em PC fraco." Style="{StaticResource Hint}"/></StackPanel><CheckBox x:Name="tgVideoBg" Style="{StaticResource Toggle}"/></Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Atualizações" Style="{StaticResource CardTitle}"/>
                <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,190,0"><TextBlock x:Name="txtSelfVer" Text="MHGU Launcher" Style="{StaticResource Lbl}"/><TextBlock x:Name="txtSelfVerSub" Text="Procurando atualização..." Style="{StaticResource Hint}"/></StackPanel><Button x:Name="btnSelfCheck" Style="{StaticResource Btn}" Content="Procurar de novo" HorizontalAlignment="Right" VerticalAlignment="Center" Width="170"/></Grid>
                <Grid Style="{StaticResource Row}"><StackPanel Margin="0,0,190,0"><TextBlock x:Name="txtVer" Text="MHGURecomp" Style="{StaticResource Lbl}"/><TextBlock x:Name="txtVerSub" Text="Procurando atualização..." Style="{StaticResource Hint}"/></StackPanel><Button x:Name="btnUpdate" Style="{StaticResource Btn}" Content="Procurar de novo" HorizontalAlignment="Right" VerticalAlignment="Center" Width="170"/></Grid>
                <TextBlock Text="A atualização troca só os arquivos do port. Jogo, tradução, mods, saves e configurações ficam como estão." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Pastas" Style="{StaticResource CardTitle}"/>
                <WrapPanel>
                  <Button x:Name="btnOpenGame" Style="{StaticResource Chip}" Content="Pasta do jogo"/>
                  <Button x:Name="btnOpenSave" Style="{StaticResource Chip}" Content="Saves"/>
                  <Button x:Name="btnOpenShots" Style="{StaticResource Chip}" Content="Screenshots"/>
                  <Button x:Name="btnOpenLog" Style="{StaticResource Chip}" Content="Log do jogo"/>
                  <Button x:Name="btnResetIni" Style="{StaticResource Chip}" Content="Restaurar padrões"/>
                </WrapPanel>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
