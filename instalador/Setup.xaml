<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador MHGU" Width="960" Height="640"
        WindowStyle="None" ResizeMode="CanMinimize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0E1015"/>
    <SolidColorBrush x:Key="Side" Color="#13161D"/>
    <SolidColorBrush x:Key="CardBg" Color="#191D26"/>
    <SolidColorBrush x:Key="CardHi" Color="#212633"/>
    <SolidColorBrush x:Key="Line" Color="#2A303D"/>
    <SolidColorBrush x:Key="Text" Color="#ECEEF3"/>
    <SolidColorBrush x:Key="Sub" Color="#8C93A3"/>
    <SolidColorBrush x:Key="Gold" Color="#E8A33D"/>
    <SolidColorBrush x:Key="GoldHi" Color="#F5B95A"/>
    <SolidColorBrush x:Key="Ok" Color="#4CC38A"/>
    <SolidColorBrush x:Key="Bad" Color="#E5534B"/>

    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style x:Key="H1Sub" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Gold}"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="Lbl" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,3,0,0"/><Setter Property="LineHeight" Value="19"/></Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,14"/><Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#262B37"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="#1A1205"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="26,11"/>
      <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F5B95A" Offset="0"/><GradientStop Color="#D9862A" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#262B37"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="ModeCard" TargetType="RadioButton">
      <Setter Property="GroupName" Value="mode"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="b" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="10" Padding="16,12">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CardHi}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/><Setter TargetName="b" Property="Background" Value="#221E17"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#10131A"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="SbThumb" TargetType="Thumb">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#323846"/></ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/><Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb Style="{StaticResource SbThumb}"/></Track.Thumb></Track>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="5" Background="#262B37"/>
            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#D9862A" Offset="0"/><GradientStop Color="#F5B95A" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource Bg}" CornerRadius="12" BorderBrush="#262B37" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <!-- etapas -->
      <Border Background="{StaticResource Side}" CornerRadius="12,0,0,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="22,22,22,26">
            <StackPanel Orientation="Horizontal">
              <Border Width="48" Height="48" CornerRadius="10" ClipToBounds="True"><Border.Background><ImageBrush x:Name="imgLogo" Stretch="UniformToFill"/></Border.Background></Border>
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="INSTALADOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Gold}"/>
                <TextBlock Text="MHGU para PC" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="pt-BR · HD · licas.mp3" FontSize="11" Foreground="{StaticResource Sub}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" FontSize="11" Foreground="{StaticResource Sub}" Margin="22,0,22,20" TextWrapping="Wrap">feito por <Run Text="licas.mp3" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/></TextBlock>
          <StackPanel x:Name="stepsPanel" Margin="22,0"/>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="titleBar" Background="Transparent">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnMin" Style="{StaticResource WinBtn}" Content="&#xE921;"/>
            <Button x:Name="btnClose" Style="{StaticResource WinBtn}" Content="&#xE8BB;"/>
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="34,0,26,0">

          <!-- 1. BEM-VINDO -->
          <ScrollViewer x:Name="pg0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Bem-vindo, caçador!" Style="{StaticResource H1}"/>
              <TextBlock Text="Este instalador coloca Monster Hunter Generations Ultimate no PC, já traduzido. Leva uns 10 minutos." Style="{StaticResource H1Sub}"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="O QUE VAI SER INSTALADO" Style="{StaticResource CardTitle}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="23" Foreground="{StaticResource Text}" Text="✓  Port de PC MHGURecomp (baixado do GitHub, roda nativo, sem emulador)&#x0a;✓  Tradução completa em português (pt-BR), por licas.mp3&#x0a;✓  Texturas HD + ícones de botões de PlayStation&#x0a;✓  Barra de vida do monstro e números de dano&#x0a;✓  MHGU Launcher (gráficos, FPS, online, mods) e atalho na área de trabalho"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="VOCÊ VAI PRECISAR DE" Style="{StaticResource CardTitle}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="23" Foreground="{StaticResource Text}" Text="1.  A sua cópia do jogo: o jogo base (.xci) e o update 1.4.0 (.nsp)&#x0a;2.  O arquivo prod.keys do seu Switch (se você usa Eden/Ryujinx, o instalador acha sozinho)&#x0a;     — ou as pastas exefs e romfs já extraídas pelo emulador&#x0a;3.  Uns 30 GB livres durante a instalação (no fim ocupa ~14 GB)&#x0a;4.  Windows 10/11 64 bits, placa de vídeo com Vulkan e internet"/>
                <TextBlock Text="O jogo não vem junto: é preciso ter a sua própria cópia." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>

          <!-- 2. PASTA -->
          <ScrollViewer x:Name="pg1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Onde instalar?" Style="{StaticResource H1}"/>
              <TextBlock Text="Escolha a pasta do jogo. Pode deixar a sugerida." Style="{StaticResource H1Sub}"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="PASTA DE INSTALAÇÃO" Style="{StaticResource CardTitle}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="txtDest"/>
                  <Button x:Name="btnDest" Grid.Column="1" Style="{StaticResource Btn}" Content="Escolher..." Margin="8,0,0,0"/></Grid>
                <TextBlock x:Name="txtSpace" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="DICA" Style="{StaticResource CardTitle}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Prefira um SSD: o jogo carrega bem mais rápido. Evite pastas como Arquivos de Programas ou OneDrive. Se já existir um MHGURecomp nessa pasta, o instalador aproveita o que já estiver lá."/>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>

          <!-- 3. SEU JOGO -->
          <ScrollViewer x:Name="pg2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Sua cópia do jogo" Style="{StaticResource H1}"/>
              <TextBlock Text="Escolha como você tem o jogo. Cada arquivo é conferido na hora: aparece ✓ quando estiver certo." Style="{StaticResource H1Sub}"/>
              <UniformGrid Columns="2" Margin="-5,0,-5,12">
                <RadioButton x:Name="rbFiles" Style="{StaticResource ModeCard}" Margin="5,0" IsChecked="True">
                  <StackPanel><TextBlock Text="Tenho os arquivos do jogo" FontSize="15" FontWeight="SemiBold"/><TextBlock Text=".xci + update .nsp + prod.keys (recomendado)" FontSize="12" Foreground="{StaticResource Sub}"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="rbDump" Style="{StaticResource ModeCard}" Margin="5,0">
                  <StackPanel><TextBlock Text="Já extraí pelo emulador" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="pastas exefs e romfs (versão 1.4.0)" FontSize="12" Foreground="{StaticResource Sub}"/></StackPanel>
                </RadioButton>
              </UniformGrid>

              <StackPanel x:Name="panelFiles">
                <Border Style="{StaticResource Card}"><StackPanel>
                  <Grid><TextBlock Text="1 · JOGO BASE (.XCI)" Style="{StaticResource CardTitle}"/><TextBlock x:Name="okXci" HorizontalAlignment="Right" FontSize="12"/></Grid>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="É a cópia do cartucho do jogo. O arquivo termina em .xci e tem entre 12 e 16 GB. Ex.: &quot;Monster Hunter Generations Ultimate.xci&quot;."/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="txtXci" IsReadOnly="True"/><Button x:Name="btnXci" Grid.Column="1" Style="{StaticResource Btn}" Content="Procurar..." Margin="8,0,0,0"/></Grid>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                  <Grid><TextBlock Text="2 · ATUALIZAÇÃO 1.4.0 (.NSP)" Style="{StaticResource CardTitle}"/><TextBlock x:Name="okNsp" HorizontalAlignment="Right" FontSize="12"/></Grid>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="O update do jogo na versão 1.4.0. Termina em .nsp e tem uns 200 MB. Ex.: &quot;Monster Hunter GU [v1.4.0][Update].nsp&quot;. Sem ele o port não abre."/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="txtNsp" IsReadOnly="True"/><Button x:Name="btnNsp" Grid.Column="1" Style="{StaticResource Btn}" Content="Procurar..." Margin="8,0,0,0"/></Grid>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                  <Grid><TextBlock Text="3 · CHAVES DO SWITCH (PROD.KEYS)" Style="{StaticResource CardTitle}"/><TextBlock x:Name="okKeys" HorizontalAlignment="Right" FontSize="12"/></Grid>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Arquivo de texto que abre a criptografia do jogo. Quem usa emulador já tem: Eden e yuzu guardam em %APPDATA%\eden\keys (ou \yuzu\keys); Ryujinx em %APPDATA%\Ryujinx\system. Clique em Achar sozinho."/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="txtKeys" IsReadOnly="True"/>
                    <Button x:Name="btnKeysAuto" Grid.Column="1" Style="{StaticResource Btn}" Content="Achar sozinho" Margin="8,0,0,0" Foreground="{StaticResource Gold}"/>
                    <Button x:Name="btnKeys" Grid.Column="2" Style="{StaticResource Btn}" Content="Procurar..." Margin="8,0,0,0"/></Grid>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Background="#15181F"><StackPanel>
                  <TextBlock Text="NÃO TENHO ESSES ARQUIVOS" Style="{StaticResource CardTitle}"/>
                  <TextBlock Style="{StaticResource Hint}" Text="Eles saem do seu próprio Switch: o jogo e o update com o nxdumptool, e o prod.keys com o Lockpick_RCM (homebrew). Se você joga no Eden ou Ryujinx, os arquivos .xci/.nsp são os que você abre no emulador. Este instalador não baixa o jogo."/>
                </StackPanel></Border>
              </StackPanel>

              <StackPanel x:Name="panelDump" Visibility="Collapsed">
                <Border Style="{StaticResource Card}"><StackPanel>
                  <Grid><TextBlock Text="PASTA COM EXEFS E ROMFS" Style="{StaticResource CardTitle}"/><TextBlock x:Name="okDump" HorizontalAlignment="Right" FontSize="12"/></Grid>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Escolha a pasta que tem dentro as pastas exefs e romfs do jogo na versão 1.4.0 (com o update aplicado)."/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="txtDump" IsReadOnly="True"/><Button x:Name="btnDump" Grid.Column="1" Style="{StaticResource Btn}" Content="Procurar..." Margin="8,0,0,0"/></Grid>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Background="#15181F"><StackPanel>
                  <TextBlock Text="COMO EXTRAIR NO EMULADOR" Style="{StaticResource CardTitle}"/>
                  <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Text="1. Instale o update 1.4.0 no emulador (Eden/yuzu: Arquivo &gt; Instalar arquivos; Ryujinx: botão direito &gt; Gerenciar atualizações).&#x0a;2. Botão direito no jogo &gt; Extrair RomFS (Dump RomFS) e Extrair ExeFS.&#x0a;3. Junte as duas pastas (exefs e romfs) numa pasta só e escolha ela aqui."/>
                </StackPanel></Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- 4. INSTALANDO -->
          <Grid x:Name="pg3" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock x:Name="txtInstTitle" Text="Instalando..." Style="{StaticResource H1}"/>
              <TextBlock x:Name="txtInstSub" Text="Pode deixar rodando. Não feche esta janela." Style="{StaticResource H1Sub}"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel>
              <Grid Margin="0,0,0,8"><TextBlock x:Name="txtNow" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="txtPct" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldHi}" HorizontalAlignment="Right"/></Grid>
              <ProgressBar x:Name="bar" Minimum="0" Maximum="100"/>
              <StackPanel x:Name="taskList" Margin="0,14,0,0"/>
            </StackPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,12">
              <ScrollViewer x:Name="logScroll" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="txtLog" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource Sub}" TextWrapping="Wrap"/></ScrollViewer>
            </Border>
          </Grid>

          <!-- 5. PRONTO -->
          <ScrollViewer x:Name="pg4" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="46" Foreground="{StaticResource Ok}" Margin="0,10,0,10"/>
              <TextBlock Text="Pronto! Boa caçada." Style="{StaticResource H1}"/>
              <TextBlock x:Name="txtDone" Style="{StaticResource H1Sub}"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="PRIMEIROS PASSOS" Style="{StaticResource CardTitle}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="23" Foreground="{StaticResource Text}" Text="1.  Abra pelo atalho &quot;MHGU PC (pt-BR HD)&quot; na área de trabalho.&#x0a;2.  No launcher, ajuste gráficos e FPS e clique em JOGAR.&#x0a;3.  Tem save no Eden/Ryujinx? A tela Início do launcher oferece importar.&#x0a;4.  No jogo: F11 tela cheia · Esc janela · Insert menu da barra de vida e dano."/>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- rodapé -->
        <Border Grid.Row="2" Padding="34,14,34,20" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
          <Grid>
            <TextBlock x:Name="txtFooter" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,260,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="btnBack" Style="{StaticResource Btn}" Content="Voltar" Padding="20,11" Margin="0,0,10,0"/>
              <Button x:Name="btnNext" Style="{StaticResource Primary}" Content="Começar"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
